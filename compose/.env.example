# 本文件是示例，不要直接用于生产环境。
# 生产环境请通过 GitHub Secrets / 服务器环境变量注入。

API_PORT=18000

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

POSTGRES_DSN=postgresql://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0

ENVIRONMENT=dev

# 本地 dev 可以用 build；prod/CI/CD 场景建议使用 GHCR 镜像。
IMAGE_NAME=cicd-study-api
IMAGE_TAG=local
